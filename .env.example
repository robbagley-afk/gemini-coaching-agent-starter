# ==============================================================================
# Primary Inference: Mac Studio LM Studio (Qwen via Public Tailscale Tunnel)
# ==============================================================================
LM_STUDIO_URL=https://mac-studio-2.tail299fc7.ts.net:8443/v1
MODEL_NAME=qwen3-vl-30b-a3b-instruct-mlx

# The public endpoint above requires an API key -- it is not open access.
# To get one: email robbagley@ensign.edu with your name and intended use.
# Without a key, Tier 1 (Qwen) will silently fail and the app falls back to
# Tier 2 (Gemini, if GEMINI_API_KEY is set below) or Tier 3 (offline guidance).
LM_STUDIO_API_KEY=

# ==============================================================================
# Fallback Inference: Google Gemini (Used automatically if Qwen is unreachable)
# ==============================================================================
# Optional: Paste your free Gemini API key below to enable cloud fallback.
# Get one at https://aistudio.google.com/apikey (free tier available, no
# credit card required). Recommended even if you have an LM Studio key, so
# the app keeps working if the Mac Studio is ever offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Server & Rate Limiting Configurations
# ==============================================================================
PORT=5050
HOST=0.0.0.0
RATE_LIMIT_PER_MIN=50
